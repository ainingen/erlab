{
  "_note": "報告に添えるコメントの所見一覧。全症例で同じ一覧を、常に全部出す。症例ごとに書き足さない。自由記述は作らない。仕様は docs/comment-list.md（docs/readable.md 2章の改訂）。",
  "_placeholder_note": "{item} 項目の略号 ／ {value}{now} いまの値 ／ {prev} 前回値 ／ {grade} 溶血の段階（「（2+）」の形。無ければ空） ／ {sample} 検体状態欄の内容。描画時に埋める。",
  "_speech_note": "text は報告の文面、speech は緊急報告の電話で読み上げる言い方。中身は同じことを言う。",
  "_scope_note": "scope=mark はマークした行ごとに展開する（候補IDは templateId:testId）。scope=all は一度だけ出す（候補IDは templateId）。",
  "_when_note": "候補を出す条件。文が成立するかだけを見る。always は常に出す。previous は前回値のある行だけ。sample_state / sample_state_clear / recheck / recollect_same / recollect_normal は事実の文で、その事実があるときだけ出す。",
  "max_lines": 3,
  "groups": [
    {
      "id": "value",
      "label": "値について",
      "open": true
    },
    {
      "id": "sample",
      "label": "検体について",
      "open": false
    },
    {
      "id": "action",
      "label": "操作と再採血",
      "open": false
    }
  ],
  "templates": [
    {
      "id": "real",
      "group": "value",
      "scope": "mark",
      "when": "always",
      "text": "{item}：採血に問題なし、値は患者由来と判断",
      "speech": "{item} {value}、採血に問題なく、患者由来の値と判断します"
    },
    {
      "id": "continued",
      "group": "value",
      "scope": "mark",
      "when": "previous",
      "text": "{item}：前回（{prev}）から継続、急な変化なし",
      "speech": "{item} {now}、前回{prev}から継続で、急な変化はありません"
    },
    {
      "id": "delta",
      "group": "value",
      "scope": "mark",
      "when": "previous",
      "text": "{item}：前回値から急な変化（{prev}→{now}）",
      "speech": "{item}、前回{prev}から{now}です"
    },
    {
      "id": "microcytic",
      "group": "value",
      "scope": "all",
      "when": "always",
      "text": "小球性低色素性の像（Hb・MCV・MCH 低値）",
      "speech": "小球性低色素性の像です。Hb・MCV・MCH が低値です"
    },
    {
      "id": "macrocytic",
      "group": "value",
      "scope": "all",
      "when": "always",
      "text": "大球性の像（MCV 高値）",
      "speech": "大球性の像です。MCV が高値です"
    },
    {
      "id": "inflammation",
      "group": "value",
      "scope": "all",
      "when": "always",
      "text": "WBC・CRP 上昇、炎症反応として整合",
      "speech": "WBC・CRP が上昇しており、炎症反応として整合します"
    },
    {
      "id": "renal",
      "group": "value",
      "scope": "all",
      "when": "always",
      "text": "Cre・BUN 上昇、腎機能低下と整合",
      "speech": "Cre・BUN が上昇しており、腎機能低下と整合します"
    },
    {
      "id": "hemolysis",
      "group": "sample",
      "scope": "mark",
      "when": "always",
      "text": "{item}：溶血{grade}の影響を疑う",
      "speech": "{item} {value}、溶血{grade}の影響を疑います"
    },
    {
      "id": "clot",
      "group": "sample",
      "scope": "mark",
      "when": "always",
      "text": "{item}：EDTA凝集の可能性",
      "speech": "{item} {value}、EDTA凝集の可能性があります"
    },
    {
      "id": "dilution",
      "group": "sample",
      "scope": "mark",
      "when": "always",
      "text": "{item}：点滴側採血の疑い",
      "speech": "{item} {value}、点滴側採血の疑いがあります"
    },
    {
      "id": "mismatch",
      "group": "sample",
      "scope": "all",
      "when": "always",
      "text": "検体取り違えの疑い（前回値と不一致）",
      "speech": "検体取り違えの疑いがあります。前回値と一致しません"
    },
    {
      "id": "sample_state",
      "group": "sample",
      "scope": "all",
      "when": "sample_state",
      "text": "検体状態：{sample}",
      "speech": "検体状態、{sample}です"
    },
    {
      "id": "sample_state_clear",
      "group": "sample",
      "scope": "all",
      "when": "sample_state_clear",
      "text": "検体状態に特記なし",
      "speech": "検体状態に特記はありません"
    },
    {
      "id": "recheck",
      "group": "action",
      "scope": "all",
      "when": "recheck",
      "text": "再採血を依頼中",
      "speech": "再採血を依頼しています"
    },
    {
      "id": "recollect_same",
      "group": "action",
      "scope": "mark",
      "when": "recollect_same",
      "text": "{item}：再採血で同値（{now}）",
      "speech": "{item} {now}、再採血で同値です"
    },
    {
      "id": "recollect_normal",
      "group": "action",
      "scope": "mark",
      "when": "recollect_normal",
      "text": "{item}：再採血で基準範囲内（{now}）",
      "speech": "{item} {now}、再採血で基準範囲内です"
    }
  ]
}
