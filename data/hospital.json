{
  "_note": "架空病院『青波総合病院』の検査室運用規定。基準範囲・パニック値はこの1セットのみを正とする。数値の追加・変更時は docs/sources.md に出典を書くこと。",
  "hospital": {
    "name": "青波総合病院",
    "lab": "中央検査部 検体検査室",
    "policy_version": "2026-04版",
    "fictional": true
  },
  "panels": {
    "CBC": {
      "label": "血算",
      "tests": ["WBC", "RBC", "Hb", "Ht", "MCV", "MCH", "MCHC", "PLT"]
    },
    "CHEM_BASIC": {
      "label": "生化学（基本）",
      "tests": ["Na", "K", "Cl", "HCO3", "BUN", "Cre", "Glu", "AST", "ALT", "LD", "CRP", "Ca", "AG"]
    }
  },
  "reference": {
    "WBC": { "low": 3.3, "high": 8.6 },
    "RBC": { "M": { "low": 4.35, "high": 5.55 }, "F": { "low": 3.86, "high": 4.92 } },
    "Hb": { "M": { "low": 13.7, "high": 16.8 }, "F": { "low": 11.6, "high": 14.8 } },
    "Ht": { "M": { "low": 40.7, "high": 50.1 }, "F": { "low": 35.1, "high": 44.4 } },
    "MCV": { "low": 83.6, "high": 98.2 },
    "MCH": { "low": 27.5, "high": 33.2 },
    "MCHC": { "low": 31.7, "high": 35.3 },
    "PLT": { "low": 158, "high": 348 },
    "Na": { "low": 138, "high": 145 },
    "K": { "low": 3.6, "high": 4.8 },
    "Cl": { "low": 101, "high": 108 },
    "HCO3": { "low": 22.0, "high": 26.0 },
    "BUN": { "low": 8, "high": 20 },
    "Cre": { "M": { "low": 0.65, "high": 1.07 }, "F": { "low": 0.46, "high": 0.79 } },
    "Glu": { "low": 73, "high": 109 },
    "AST": { "low": 13, "high": 30 },
    "ALT": { "M": { "low": 10, "high": 42 }, "F": { "low": 7, "high": 23 } },
    "LD": { "low": 124, "high": 222 },
